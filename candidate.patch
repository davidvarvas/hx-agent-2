+        x, y, z = self.pos
+        gx, gy = zone["next_center"]
+        stats = self.me["stats"]
+        speed = stats["walk_speed"]
+        distance = math.hypot(gx - x, gy - y)
+        if fighting and zone["radius"] > speed:
+            return None
+        if distance > speed * 0.85:
